{
  "name": "wosate",
  "version": "0.3.0",
  "description": "WOSATE: a browser-based AADL tool environment (OSATE-style) with AGREE verification and a plug-in API",
  "private": true,
  "type": "module",
  "bin": {
    "wosate": "tools/wosate.mjs"
  },
  "scripts": {
    "wosate": "node tools/wosate.mjs",
    "build:vendor": "node tools/build-vendor.mjs",
    "build": "node tools/build-vendor.mjs && vite build",
    "dev": "node tools/build-vendor.mjs && vite",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.10.2",
    "coi-serviceworker": "0.1.7",
    "vite": "^8.3.6",
    "z3-solver": "4.13.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@vscode/codicons": "^0.0.46-24",
    "@xyflow/react": "^12.12.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.33"
  }
}
